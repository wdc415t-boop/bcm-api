# ── BeachCombersMania API Server ──────────────────────────────
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Anthropic API Key (from console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-api03-YOUR_KEY_HERE

# Server port (Render sets PORT automatically)
PORT=3001

# Allowed origins (comma-separated) — your Hostinger domains
ALLOWED_ORIGINS=https://marcomania.online,https://naplesmania.online,https://bonitamania.online,https://ftmyersmania.online,https://sanibelmania.online,https://captivamania.online,https://beachcombersmania.online,https://marcomainia.online

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Environment
NODE_ENV=production

# ── Phase 1 shell identification (2026-10-28) ──
# Claude model for /api/identify (and dining/boats). claude-opus-5-5 is the no-deploy upgrade.
BCM_MODEL=claude-sonnet-5-5
# Where the server refreshes the species catalog from once a day (the file Bill edits)
BCM_CATALOG_URL=https://beachcombersmania.online/assets/MASTER-SHELL-DB.json
# Calibrated decider: "off" or an OpenRouter decisions model id such as typesafe/jev-1.14
BCM_DECIDER=off
# Needed only when BCM_DECIDER is not "off" (openrouter.ai/settings/keys)
OPENROUTER_API_KEY=
# Random string; requests with header X-BCM-Eval: <this> skip the scan meter (eval harness)
BCM_EVAL_KEY=
